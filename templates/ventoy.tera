---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
  filename: "ventoy/src/{{ flavor.identifier }}/catppuccin-{{ flavor.identifier }}/theme.txt"
  hex_format: "#{{R}}{{G}}{{B}}{{Z}}"
---
# Global Property
title-text: ""
desktop-color: "{{ if(cond=flavor.dark, t=base.hex, f=crust.hex) }}"
terminal-font: "Terminus 14"
terminal-left: "0"
terminal-top: "0"
terminal-width: "100%"
terminal-height: "100%"
terminal-border: "0"

# Logo image
+ image {
	left = 50%-96
	top = 20%-27
    file = "logo-narrow.png"
}
# Footer image
+ image {
	left = 40%-255
	top = 90%-30
    file = "footer-narrow.png"
}
+ image {
	left = 0%
	top = 90%+8
	width = 100%
    file = "line.png"
}

# Show the boot menu
+ boot_menu {
  left = 50%-390
  top = 30%
  width = 780
  height = 30%
  item_font = "Unifont Regular 16"
  item_color = "{{ text.hex }}"
  selected_item_color = "{{ text.hex }}"
  icon_width = 32
  icon_height = 32
  item_icon_space = 20
  item_height = 36
  item_padding = 5
  item_spacing = 10
  selected_item_pixmap_style = "select_*.png"
}

# Show a countdown message using the label component
+ label {
  top = 82%
  left = 35%
  width = 30%
  align = "center"
  id = "__timeout__"
  text = "@TIMEOUT_NOTIFICATION_SHORT@"
  color = "{{ text.hex }}"
}

+ hbox{
    left = 30%
    top = 95%
    width = 10%
    height = 25
    + label {text = "@VTOY_HOTKEY_TIP@" color = "{{ text.hex }}" align = "left"}
}


+ hbox{
    left = 30%
    top = 95%-50
    width = 10%
    height = 25
    + label {text = "@VTOY_ISO_RAW@" color = "{{ red.hex }}" align = "left"}
}


+ hbox{
    left = 30%+200
    top = 95%-50
    width = 10%
    height = 25
    + label {text = "@VTOY_GRUB2_MODE@" color = "{{ red.hex }}" align = "left"}
}

+ hbox{
    left = 30%+200
    top = 95%-25
    width = 10%
    height = 25
    + label {text = "@VTOY_WIMBOOT_MODE@" color = "{{ red.hex }}" align = "left"}
}

+ hbox{
    left = 90%
    top = 55
    width = 10%
    height = 25
    + label {text = "@VTOY_ISO_UEFI_DRV@" color = "{{ red.hex }}" align = "left"}
}
